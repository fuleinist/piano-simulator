{
  // Static assets only: `npm run build` writes the site to dist/, and
  // `wrangler deploy` publishes that folder as a Worker with no script.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piano-simulator",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    // The app is a single page, so an unknown path falls back to index.html
    // instead of a bare 404 page.
    "not_found_handling": "single-page-application"
  }
}